<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/finance_light_gray"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:background="@color/finance_navy"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Goal Zone"
                    android:textColor="@color/finance_white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Set your monthly money training range."
                    android:textColor="@color/finance_teal"
                    android:textSize="15sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-28dp"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/finance_white"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvGoalMonth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Current Month"
                        android:textColor="@color/finance_navy"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Minimum training range"
                        android:textColor="@color/finance_dark_navy"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtMinGoal"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="Example: 1000"
                        android:inputType="numberDecimal"
                        android:padding="14dp"
                        android:textColor="@color/finance_dark_navy"
                        android:textColorHint="@color/finance_gray" />

                    <SeekBar
                        android:id="@+id/seekMinGoal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="20000"
                        android:progress="1000" />

                    <TextView
                        android:id="@+id/tvMinGoalPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Minimum preview: R1,000.00"
                        android:textColor="@color/finance_gray"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Maximum training range"
                        android:textColor="@color/finance_dark_navy"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtMaxGoal"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="Example: 5000"
                        android:inputType="numberDecimal"
                        android:padding="14dp"
                        android:textColor="@color/finance_dark_navy"
                        android:textColorHint="@color/finance_gray" />

                    <SeekBar
                        android:id="@+id/seekMaxGoal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="50000"
                        android:progress="5000" />

                    <TextView
                        android:id="@+id/tvMaxGoalPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Maximum preview: R5,000.00"
                        android:textColor="@color/finance_gray"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnSaveGoals"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="28dp"
                        android:background="@drawable/bg_primary_button"
                        android:text="Save Goal Zone"
                        android:textAllCaps="false"
                        android:textColor="@color/finance_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGoalMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/finance_red"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/finance_white"
        app:itemIconTint="@color/bottom_nav_item_colour"
        app:itemTextColor="@color/bottom_nav_item_colour"
        app:itemActiveIndicatorStyle="@null"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>